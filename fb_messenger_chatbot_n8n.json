    {
      "parameters": {
        "jsCode": "// Robustly parse the agent's JSON output.\nconst raw = ($json.output || $json.text || '').toString().trim();\nlet parsed = null;\ntry {\n  // Strip code fences if present\n  const cleaned = raw.replace(/^```(?:json)?/i, '').replace(/```$/,'').trim();\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  // Fallback: try to find first JSON object inside text\n  const m = raw.match(/\\{[\\s\\S]*\\}/);\n  if (m) { try { parsed = JSON.parse(m[0]); } catch (_) {} }\n}\nif (!parsed) parsed = { reply: raw || 'Sorry, ektu por abar try korben please.', action: 'reply', order: {}, lead: {} };\n\nconst ctx = $('Prepare Agent Input').item.json;\nreturn [{\n  json: {\n    psid: ctx.psid,\n    user_message: ctx.text,\n    reply: parsed.reply || '',\n    action: (parsed.action || 'reply').toLowerCase(),\n    order: parsed.order || {},\n    lead: parsed.lead || {},\n    ts: ctx.ts\n  }\n}];\n"
      },
      "id": "n-parse",
      "name": "Parse Agent Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1080, 220]
    },

