    {
      "parameters": {
        "jsCode": "// Combine inputs: user row, products list, and current message into one object for the agent.\nconst userItem = $input.first();\nconst userRow = (userItem && userItem.json) || {};\n\n// Use modern n8n syntax: $('NodeName').all() instead of deprecated $items()\nconst productItems = $('Get Products').all().map(i => i.json);\nconst msg = $('Merge Message').first().json;\n\nconst products = productItems\n  .filter(p => (p.status || '').toString().toLowerCase() === 'active')\n  .map(p => `- ${p.product_id || ''} | ${p.name || ''} | size: ${p.size || ''} | color: ${p.color || ''} | price: ${p.price || ''} BDT | stock: ${p.stock || 0} | ${p.description || ''}`)\n  .join('\\n');\n\nreturn [{\n  json: {\n    psid: String(msg.psid || ''),\n    text: msg.text || '',\n    ts: msg.ts || new Date().toISOString(),\n    user_name: userRow.name || '',\n    user_status: userRow.status || 'new',\n    ai_enabled: userRow.ai_enabled === undefined ? true : (userRow.ai_enabled === true || String(userRow.ai_enabled).toUpperCase() === 'TRUE'),\n    last_message_at: userRow.last_message_at || '',\n    products_text: products || '(no active products in catalog)'\n  }\n}];\n"
      },
      "id": "n-prep-input",
      "name": "Prepare Agent Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [560, 220]
    },

    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.text }}",
        "options": {
          "systemMessage": "Tumi ekta Bangladeshi e-commerce shop er friendly Facebook Messenger assistant.\n\nREPLY STYLE (sheet-driven):\n- Default reply Banglish e (Bangla written using English letters), max 1-2 short sentences.\n- Customer pure Bangla likhle pure Bangla te reply koro.\n- Always polite, human-friendly, emoji use sparingly (max 1).\n- Never invent product, price, stock — sudhu CATALOG theke information use korbe.\n\nACTIONS — chose exactly one:\n- \"reply\"          → general chat / FAQ / product info.\n- \"order_update\"   → customer order place korte chai / confirm korte chai / change korte chai. Fill `order` object.\n- \"lead_update\"    → customer name / phone / address share korlo, OR status change (new→lead→customer→closed). Fill `lead` object.\n- \"human_support\"  → customer human/agent/manager chai, OR complaint, OR tumi answer dite parcho na, OR sensitive issue. Fill `reply` with a short \"ekjon agent ekhoni connect korbe\" message.\n\nSTRICT OUTPUT FORMAT — return ONLY valid JSON, no prose, no markdown, no code fences:\n{\n  \"reply\": \"<short Banglish/Bangla message to the customer>\",\n  \"action\": \"reply\" | \"order_update\" | \"lead_update\" | \"human_support\",\n  \"order\": { \"product\": \"\", \"size\": \"\", \"quantity\": 1, \"price\": 0, \"address\": \"\", \"phone\": \"\", \"status\": \"pending\", \"note\": \"\" } ,\n  \"lead\":  { \"name\": \"\", \"status\": \"new\" }\n}\nIf a field is unknown, use empty string \"\" or 0. Never omit keys.\n\nCATALOG (only these products are real):\n{{ $json.products_text }}\n\nCUSTOMER PROFILE:\npsid: {{ $json.psid }}\nname: {{ $json.user_name }}\nstatus: {{ $json.user_status }}\nlast_message_at: {{ $json.last_message_at }}",
          "maxIterations": 5
        }
      },
