    {
      "parameters": {
        "jsCode": "// Keep only stale leads: status in (new, lead) AND last_message_at older than 8h AND followup_count < 3\nconst now = Date.now();\nconst eightHrs = 8 * 60 * 60 * 1000;\nreturn $input.all()\n  .map(i => i.json)\n  .filter(u => {\n    const s = (u.status || '').toString().toLowerCase();\n    if (s !== 'new' && s !== 'lead') return false;\n    const last = u.last_message_at ? new Date(u.last_message_at).getTime() : 0;\n    if (!last || (now - last) < eightHrs) return false;\n    const fc = parseInt(u.followup_count || 0, 10);\n    if (fc >= 3) return false;\n    return true;\n  })\n  .map(u => ({ json: u }));\n"
      },
      "id": "n-filter-stale",
