      "id": "02c32469-c52f-4f4c-8e3d-44c05aec4e33",
      "name": "Get Products",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        760,
        160
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// Build Product Documents from Products sheet rows.\nconst items = $input.all();\nconst out = [];\nfor (const it of items) {\n  const p = it.json;\n  const status = (p.status || '').toString().trim().toLowerCase();\n  if (status && status !== 'active') continue;\n  const name = (p.name || '').toString().trim();\n  if (!name) continue;\n  const id = (p.product_id || `prd-${out.length+1}`).toString().trim();\n  const lines = [\n    `Type: Product`,\n    `Product ID: ${id}`,\n    `Name: ${name}`,\n    `Category: ${p.category || ''}`,\n    `Size: ${p.size || ''}`,\n    `Color: ${p.color || ''}`,\n    `Price: ${p.price ?? ''}`,\n    `Stock: ${p.stock ?? ''}`,\n    `Status: ${p.status || ''}`,\n    `Description: ${p.description || ''}`,\n  ].filter(l => (l.split(': ')[1] || '').toString().trim() !== '');\n  out.push({ json: {\n    content: lines.join('\\n'),\n    metadata: {\n      id: `product-${id}`,\n      source: 'products_sheet',\n      type: 'product',\n      product_id: id,\n      name: name,\n      category: (p.category || '').toString()\n    }\n  }});\n}\nreturn out;\n"
      },
      "id": "cd5a4a40-859f-47c4-adec-14cc07514134",
      "name": "Build Product Documents",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1060,
        160
      ]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "REPLACE_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Setup",
          "mode": "name"
        },
        "options": {
          "returnAllMatches": true,
          "headerRow": 4,
          "dataStartRow": 5
        }
      },
      "id": "b5f4e55f-bc30-40a4-828f-ded9218024b0",
      "name": "Get Setup",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        760,
        380
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// Build Setup Documents from Setup sheet rows.\nconst items = $input.all();\nconst out = [];\nconst SECRET_RX = /(token|secret|password|api[_ ]?key|sheet[_ ]?id|chat[_ ]?id)/i;\nconst ALLOW_RX  = /(reply|style|memory|max|tone|language|hour|policy|rule|instruction|behavior|prompt)/i;\nfor (const it of items) {\n  const s = it.json;\n  const key = (s.key || '').toString().trim();\n  const val = (s.value === 0 ? '0' : (s.value || '').toString()).trim();\n  if (!key || !val) continue;\n  if (SECRET_RX.test(key) && !ALLOW_RX.test(key)) continue;\n  const notes = (s.notes || '').toString().trim();\n  const stableId = key.toLowerCase().replace(/[^a-z0-9]+/g, '_');\n  const lines = [\n    `Type: Setup`,\n    `Key: ${key}`,\n    `Value: ${val}`,\n    notes ? `Notes: ${notes}` : '',\n  ].filter(Boolean);\n  out.push({ json: {\n    content: lines.join('\\n'),\n    metadata: {\n      id: `setup-${stableId}`,\n      source: 'setup_sheet',\n      type: 'setup',\n      key: key\n    }\n  }});\n}\nreturn out;\n"
      },
      "id": "7bae5e50-7e59-46f3-9333-e3a00a16e642",
      "name": "Build Setup Documents",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1060,
        380
