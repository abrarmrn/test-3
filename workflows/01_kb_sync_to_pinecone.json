      "id": "31da9f9b-8c09-49e9-a779-c07e1e5dab5e",
      "name": "Get Products",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        240,
        400
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.status }}",
              "rightValue": "active",
              "operator": {
                "type": "string",
                "operation": "equals",
                "name": "filter.operator.equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "06ce8f5c-8421-4764-b3e8-978df8d5211a",
      "name": "Only Active",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "// Convert one Products row into a clean searchable document.\n// Output: { content, metadata } per item.\nconst items = $input.all();\nconst out = [];\nfor (const it of items) {\n  const p = it.json;\n  const name = (p.name || '').toString().trim();\n  const cat  = (p.category || '').toString().trim();\n  const size = (p.size || '').toString().trim();\n  const color= (p.color || '').toString().trim();\n  const desc = (p.description || '').toString().trim();\n  const price= p.price;\n  const stock= p.stock;\n  const status=(p.status|| '').toString().trim();\n  // Build human-readable doc \u2014 covers product info, size, FAQ, objections.\n  const lines = [\n    `Product: ${name}`,\n    `Category: ${cat}`,\n    `Available sizes: ${size}`,\n    `Available colors: ${color}`,\n    `Price (BDT): ${price}`,\n    `Stock: ${stock}`,\n    `Status: ${status}`,\n    `Description: ${desc}`,\n    `Size guide: ${name} comes in sizes ${size}. Customer should pick the closest size.`,\n    `FAQ: ${name} er dam ${price} taka. Stock ${stock} ti ache. Color: ${color}.`,\n    `Objection handling: Quality bhalo, ${desc}. Confirm korar pore COD e pathano hoy.`\n  ];\n  const content = lines.join('\\n');\n  out.push({ json: {\n     content,\n     metadata: {\n       product_id: p.product_id,\n       name, category: cat, price, status,\n       source: 'products_sheet'\n     }\n  }});\n}\nreturn out;\n"
      },
      "id": "74842498-76ff-42f8-9491-c316509df2a1",
      "name": "Build Document",
