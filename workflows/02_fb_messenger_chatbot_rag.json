    {
      "parameters": {
        "jsCode": "// Intent detection \u2014 pure Code/IF, no LLM, no RAG.\n// State machine first (active order flow), then keywords.\nconst j = $input.first().json;\nconst text  = (j.text || '').trim();\nconst lower = text.toLowerCase();\n\nlet memory = { turns: [], order: null, flow_state: null, last_mid: null };\ntry { if (j.memory_raw) memory = { ...memory, ...JSON.parse(j.memory_raw) }; } catch(e){}\nif (!Array.isArray(memory.turns)) memory.turns = [];\nconst flow = memory.flow_state || null;\n\nconst has = (kws) => kws.some(k => lower.includes(k));\n\n// 1) Cancel anywhere\nif (has(['cancel order','order cancel','baatil','batil korbo']))\n  return [{ json: { ...j, intent: 'order_cancel', memory } }];\n\n// 2) Continue active order flow\nif (flow === 'await_product')  return [{ json: { ...j, intent: 'order_product', memory } }];\nif (flow === 'await_size')     return [{ json: { ...j, intent: 'order_size',    memory } }];\nif (flow === 'await_quantity') return [{ json: { ...j, intent: 'order_quantity',memory } }];\nif (flow === 'await_address')  return [{ json: { ...j, intent: 'order_address', memory } }];\nif (flow === 'await_phone')    return [{ json: { ...j, intent: 'order_phone',   memory } }];\nif (flow === 'await_confirm')  return [{ json: { ...j, intent: 'order_confirm', memory } }];\n\n// 3) Support escalation (human handoff)\nconst supportKw = ['human','manush','agent','real person','customer service',\n  'complain','complaint','ovijog','problem hochche','support team',\n  'kotha bolte chai','manusher shathe'];\nif (has(supportKw)) return [{ json: { ...j, intent: 'support', memory } }];\n\n// 4) Order start\nconst orderKw = ['order korbo','order korte chai','kinbo','kinte chai',\n  'nibo','nite chai','place order','order','kine nibo'];\nif (has(orderKw)) return [{ json: { ...j, intent: 'order_start', memory } }];\n\n// 5) Product / FAQ question \u2192 RAG\nconst qaKw = ['ki','koto','dam','price','size','color','available','stock',\n  'description','panjabi','saree','tshirt','t-shirt','shirt','pant',\n  'how','what','where','when','jante chai','janabe','delivery','return'];\nif (has(qaKw) || text.endsWith('?'))\n  return [{ json: { ...j, intent: 'qa', memory } }];\n\n// 6) Default \u2192 lead (greetings, intros, generic chat)\nreturn [{ json: { ...j, intent: 'lead', memory } }];\n"
      },
