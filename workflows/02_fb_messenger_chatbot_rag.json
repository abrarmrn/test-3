    {
      "parameters": {
        "jsCode": "// Intent detection: state machine + keyword match. No LLM, no RAG.\nconst j = $input.first().json;\nconst text = (j.text || '').trim();\nconst lower = text.toLowerCase();\n// Parse memory JSON safely\nlet memory = { turns: [], order: null, flow_state: null };\ntry { if (j.memory_raw) memory = JSON.parse(j.memory_raw); } catch(e){}\nif (!Array.isArray(memory.turns)) memory.turns = [];\nif (!memory.order) memory.order = null;\nconst flow = memory.flow_state || null;\nconst has = (kws) => kws.some(k => lower.includes(k));\n// Cancel anywhere\nif (has(['cancel order','order cancel','baatil','batil korbo'])) {\n  return [{ json: { ...j, intent: 'order_cancel', memory } }];\n}\n// Continue active order flow\nif (flow === 'await_product')  return [{ json: { ...j, intent: 'order_product', memory } }];\nif (flow === 'await_size')     return [{ json: { ...j, intent: 'order_size',    memory } }];\nif (flow === 'await_quantity') return [{ json: { ...j, intent: 'order_quantity',memory } }];\nif (flow === 'await_address')  return [{ json: { ...j, intent: 'order_address', memory } }];\nif (flow === 'await_phone')    return [{ json: { ...j, intent: 'order_phone',   memory } }];\nif (flow === 'await_confirm')  return [{ json: { ...j, intent: 'order_confirm', memory } }];\n// Order start keywords (Bangla / Banglish)\nconst orderKw = ['order korbo','order korte chai','kinbo','kinte chai',\n  'nibo','nite chai','place order','order','kine nibo','kinte chai'];\nif (has(orderKw)) return [{ json: { ...j, intent: 'order_start', memory } }];\n// Default \u2192 RAG QA\nreturn [{ json: { ...j, intent: 'qa', memory } }];\n"
      },
      "id": "c63c6e84-4ef6-4c8e-8895-923ac339410c",
      "name": "Detect Intent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2160,
        0
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "r1",
                    "leftValue": "={{ $json.intent }}",
                    "rightValue": "qa",
                    "operator": {
                      "type": "string",
                      "operation": "equals",
                      "name": "filter.operator.equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "qa"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "r2",
                    "leftValue": "={{ $json.intent }}",
                    "rightValue": "order_",
                    "operator": {
                      "type": "string",
                      "operation": "startsWith",
                      "name": "filter.operator.startsWith"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "order"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      },
      "id": "abd233e8-40c3-48fd-b0b1-a86f7ba7f0c2",
      "name": "Route Intent",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        2400,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Deterministic order flow \u2014 no LLM, no RAG.\nconst j = $input.first().json;\nconst intent = j.intent;\nconst text = (j.text || '').trim();\nconst lower = text.toLowerCase();\nconst psid = j.psid;\nconst userName = j.user_name || '';\nconst memory = j.memory || { turns: [], order: null, flow_state: null };\nlet order = memory.order || { product:'', size:'', quantity:1, price:0,\n  address:'', phone:'', status:'pending', note:'' };\nlet flow = memory.flow_state || null;\nlet reply = '';\nlet saveOrder = false;\n// Load product catalog from Get Products node\nlet products = [];\ntry { products = $('Get Products').all().map(x=>x.json)\n        .filter(p => (p.status||'').toLowerCase()==='active'); } catch(e){}\nconst findProduct = (q) => {\n  const ql = (q||'').toLowerCase();\n  return products.find(p => ql.includes((p.name||'').toLowerCase())\n                          || ql.includes((p.category||'').toLowerCase()));\n};\nconst isYes = /(han|haa|hae|jee|yes|ok|okay|confirm|achaa|theek|thik)/i;\nconst isNo  = /(na|no|cancel|baatil|batil)/i;\nif (intent === 'order_cancel') {\n  reply = 'Theek ache, order baatil korlam.';\n  flow = null; order = null;\n} else if (intent === 'order_start') {\n  const found = findProduct(text);\n  if (found) {\n    order.product = found.name;\n    order.price = Number(found.price) || 0;\n    flow = 'await_size';\n    reply = `${found.name} pochonder! Size ki lagbe? (${found.size})`;\n  } else {\n    flow = 'await_product';\n    const list = products.map(p=>p.name).join(', ') || 'product list';\n    reply = `Konta nibe? Available: ${list}`;\n  }\n} else if (intent === 'order_product') {\n  const found = findProduct(text);\n  if (found) {\n    order.product = found.name;\n    order.price = Number(found.price) || 0;\n    flow = 'await_size';\n    reply = `Beche nilam: ${found.name}. Size ki? (${found.size})`;\n  } else {\n    reply = 'Sorry, oi product nei. Onno ekta name din please.';\n  }\n} else if (intent === 'order_size') {\n  order.size = text.toUpperCase().slice(0,10);\n  flow = 'await_quantity';\n  reply = 'Koto ti lagbe? (e.g. 1)';\n} else if (intent === 'order_quantity') {\n  const q = parseInt((text.match(/\\d+/)||['1'])[0],10);\n  order.quantity = q > 0 ? q : 1;\n  flow = 'await_address';\n  reply = 'Apnar full address ta diben please?';\n} else if (intent === 'order_address') {\n  if (text.length < 5) {\n    reply = 'Address ta detail kore likhben please.';\n  } else {\n    order.address = text;\n    flow = 'await_phone';\n    reply = 'Address peyechi. Phone number ta diben?';\n  }\n} else if (intent === 'order_phone') {\n  const digits = text.replace(/\\D/g,'');\n  if (digits.length < 10) {\n    reply = 'Phone number sothik moto diben (11 digit).';\n  } else {\n    order.phone = digits.slice(0,15);\n    flow = 'await_confirm';\n    const total = (order.price||0) * (order.quantity||1);\n    reply = `Confirm? ${order.product} | ${order.size} | qty ${order.quantity}`+\n            ` | total ${total} BDT | ${order.phone}. (han / na)`;\n  }\n} else if (intent === 'order_confirm') {\n  if (isYes.test(lower)) {\n    order.status = 'pending';\n    saveOrder = true;\n    flow = null;\n    reply = 'Order confirm hoyeche. Shigree call korbo. Dhonnobad!';\n  } else if (isNo.test(lower)) {\n    flow = null; order = null;\n    reply = 'Theek ache, order baatil korlam.';\n  } else {\n    reply = 'Confirm korte han / na likhun.';\n  }\n}\n// Save back to memory\nmemory.flow_state = flow;\nmemory.order = saveOrder ? null : order;\n// Append turn (cap last 5)\nmemory.turns.push({ role:'user', content: text });\nmemory.turns.push({ role:'assistant', content: reply });\nmemory.turns = memory.turns.slice(-10);\nreturn [{ json: {\n  psid, user_name: userName, text, reply,\n  save_order: saveOrder,\n  order: order || {},\n  memory_json: JSON.stringify(memory)\n}}];\n"
      },
