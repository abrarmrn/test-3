    {
      "parameters": {
        "jsCode": "// Lead branch \u2014 generic friendly Banglish reply, no LLM/RAG.\n// The Upsert Lead Sheets node writes to Leads in parallel.\nconst j = $input.first().json;\nconst text = (j.text || '').trim();\nconst memory = j.memory || { turns: [], order: null, flow_state: null, last_mid: null };\n\n// Light-weight greeting detection for a slightly warmer reply\nconst lower = text.toLowerCase();\nconst isGreet = /(hi|hello|hey|salam|assalamualaikum|nomoshkar|kemon achen)/i.test(lower);\nconst reply = isGreet\n  ? 'Walaikum salam! Amader shop e shagotom. Kichu jante chaile bolun.'\n  : 'Apnar message peyechi. Product / FAQ / size \u2014 ja jante chan likhun, ami help korbo.';\n\nmemory.turns = (memory.turns || []);\nmemory.turns.push({ role: 'user', content: text });\nmemory.turns.push({ role: 'assistant', content: reply });\nmemory.turns = memory.turns.slice(-10);\nmemory.last_mid = j.mid;\n\nreturn [{ json: {\n  psid: j.psid,\n  mid: j.mid,\n  user_name: j.user_name || '',\n  text, reply,\n  memory_json: JSON.stringify(memory)\n}}];\n"
      },
