        "jsCode": "// Support branch \u2014 acknowledge and tell user a human will follow up.\n// Telegram Alert node fires in parallel to notify the support team.\nconst j = $input.first().json;\nconst text = (j.text || '').trim();\nconst memory = j.memory || { turns: [], order: null, flow_state: null, last_mid: null };\nconst reply = 'Apnar concern peyechi. Amader human support shigreei contact korbe. Dhonnobad!';\n\nmemory.turns = (memory.turns || []);\nmemory.turns.push({ role: 'user', content: text });\nmemory.turns.push({ role: 'assistant', content: reply });\nmemory.turns = memory.turns.slice(-10);\nmemory.last_mid = j.mid;\n\nreturn [{ json: {\n  psid: j.psid,\n  mid: j.mid,\n  user_name: j.user_name || '',\n  text, reply,\n  memory_json: JSON.stringify(memory),\n  alert_text: `Support needed for ${j.psid} (${j.user_name || 'unknown'}): ${text}`\n}}];\n"
