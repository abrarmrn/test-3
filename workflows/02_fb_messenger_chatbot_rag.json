    {
      "parameters": {
        "jsCode": "// Combine top-K Pinecone matches into a single context string.\nconst docs = $input.all().map(it => it.json);\nconst ctx = docs.map((d,i) => {\n  const c = d.pageContent || d.document?.pageContent || d.content || '';\n  return `[${i+1}] ${c}`;\n}).join('\\n---\\n');\n// Pull psid + question from upstream\nconst up = $('Detect Intent').item.json;\nreturn [{ json: {\n  psid: up.psid,\n  user_name: up.user_name || '',\n  text: up.text,\n  question: up.text,\n  context: ctx || 'No catalog context available.',\n  memory: up.memory\n}}];\n"
      },
      "id": "b883640b-a31c-44bc-a9f8-981b8994ad55",
      "name": "Build RAG Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2880,
        -200
      ]
    },
    {
      "parameters": {
        "resource": "chat",
        "operation": "message",
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "Tumi ekta Bangladeshi e-commerce shop er Messenger assistant. Reply STYLE: Banglish (Bangla in English letters), max 1-2 short sentences, polite, structured. Customer pure Bangla likhle pure Bangla te reply koro. ONLY use the CATALOG CONTEXT below \u2014 kono price, size, stock invent korbe na. Jodi context e na thake, bolbe: 'Ei muhurte ami sure noi, ekto pore confirm kore janabo.'"
            },
