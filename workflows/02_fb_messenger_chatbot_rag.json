    {
      "parameters": {
        "jsCode": "// Combine top-K Pinecone matches into a single context string.\nconst docs = $input.all().map(it => it.json);\nconst ctx = docs.map((d, i) => {\n  const c = d.pageContent || (d.document && d.document.pageContent) || d.content || '';\n  return `[${i+1}] ${c}`;\n}).join('\\n---\\n');\nconst up = $('Detect Intent').item.json;\nreturn [{ json: {\n  psid: up.psid,\n  mid: up.mid,\n  user_name: up.user_name || '',\n  text: up.text,\n  question: up.text,\n  context: ctx || 'No catalog context available.',\n  memory: up.memory\n}}];\n"
      },
      "id": "ed66b259-8f7a-471f-ad88-e18c04a86400",
      "name": "Build RAG Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3360,
        -460
      ]
    },
    {
      "parameters": {
        "resource": "chat",
        "operation": "message",
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "Tumi ekta Bangladeshi e-commerce shop er Messenger assistant. Reply STYLE: Banglish (Bangla in English letters), max 1-2 short sentences, polite, structured. Customer pure Bangla likhle pure Bangla te reply koro. ONLY use the CATALOG CONTEXT below \u2014 kono price, size, stock invent korbe na. Jodi context e na thake, bolbe: 'Ei muhurte ami sure noi, ekto pore confirm kore janabo.'"
            },
            {
              "role": "user",
              "content": "CATALOG CONTEXT:\n{{ $json.context }}\n\nCUSTOMER QUESTION:\n{{ $json.question }}\n\nReply now (1-2 short sentences):"
            }
          ]
        },
        "simplify": true,
        "options": {
          "temperature": 0.3,
          "maxTokens": 160
        }
      },
      "id": "8002b98d-200d-4cc4-a033-4f79b0990cb3",
      "name": "Answer (OpenAI)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        3600,
        -460
      ]
    },
    {
      "parameters": {
        "jsCode": "// Pull AI response and prepare the standard reply payload.\nconst j = $input.first().json;\nlet reply = '';\nif (typeof j.message === 'object' && j.message && j.message.content) reply = j.message.content;\nelse if (j.content) reply = j.content;\nelse if (j.text)    reply = j.text;\nelse if (j.output)  reply = j.output;\nelse reply = 'Sorry, ekhon answer dite parchi na. Ektu pore try korben?';\nreply = String(reply).trim();\n\nconst ctxItem = $('Build RAG Context').item.json;\nconst memory = ctxItem.memory || { turns: [], order: null, flow_state: null, last_mid: null };\nmemory.turns = (memory.turns || []);\nmemory.turns.push({ role: 'user', content: ctxItem.text });\nmemory.turns.push({ role: 'assistant', content: reply });\nmemory.turns = memory.turns.slice(-10);\nmemory.last_mid = ctxItem.mid;\n\nreturn [{ json: {\n  psid: ctxItem.psid,\n  mid: ctxItem.mid,\n  user_name: ctxItem.user_name,\n  text: ctxItem.text,\n  reply,\n  memory_json: JSON.stringify(memory)\n}}];\n"
      },
      "id": "0b862b90-0a7d-4f6f-bada-13f163b3e826",
      "name": "Format QA Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3840,
        -460
      ]
    },
    {
      "parameters": {
        "jsCode": "// Deterministic order flow \u2014 Code/IF only.\nconst j = $input.first().json;\nconst intent = j.intent;\nconst text   = (j.text || '').trim();\nconst lower  = text.toLowerCase();\nconst psid   = j.psid;\nconst mid    = j.mid;\nconst userName = j.user_name || '';\nconst memory   = j.memory || { turns: [], order: null, flow_state: null, last_mid: null };\nlet order = memory.order || { product:'', size:'', quantity:1, price:0,\n  address:'', phone:'', status:'pending', note:'' };\nlet flow  = memory.flow_state || null;\nlet reply = '';\nlet saveOrder = false;\n\nlet products = [];\ntry {\n  products = $('Get Products').all().map(x => x.json)\n    .filter(p => (p.status || '').toString().toLowerCase() === 'active');\n} catch (e) {}\n\nconst findProduct = (q) => {\n  const ql = (q || '').toLowerCase();\n  return products.find(p =>\n    ql.includes((p.name || '').toLowerCase()) ||\n    ql.includes((p.category || '').toLowerCase()));\n};\nconst isYes = /(han|haa|hae|jee|yes|ok|okay|confirm|achaa|theek|thik)/i;\nconst isNo  = /(na|no|cancel|baatil|batil)/i;\n\nif (intent === 'order_cancel') {\n  reply = 'Theek ache, order baatil korlam.';\n  flow = null; order = null;\n} else if (intent === 'order_start') {\n  const found = findProduct(text);\n  if (found) {\n    order.product = found.name;\n    order.price = Number(found.price) || 0;\n    flow = 'await_size';\n    reply = `${found.name} pochonder! Size ki lagbe? (${found.size})`;\n  } else {\n    flow = 'await_product';\n    const list = products.map(p => p.name).join(', ') || 'product list';\n    reply = `Konta nibe? Available: ${list}`;\n  }\n}\n\nelse if (intent === 'order_product') {\n  const found = findProduct(text);\n  if (found) {\n    order.product = found.name;\n    order.price = Number(found.price) || 0;\n    flow = 'await_size';\n    reply = `Beche nilam: ${found.name}. Size ki? (${found.size})`;\n  } else {\n    reply = 'Sorry, oi product nei. Onno ekta name din please.';\n  }\n} else if (intent === 'order_size') {\n  order.size = text.toUpperCase().slice(0, 10);\n  flow = 'await_quantity';\n  reply = 'Koto ti lagbe? (e.g. 1)';\n} else if (intent === 'order_quantity') {\n  const q = parseInt((text.match(/\\d+/) || ['1'])[0], 10);\n  order.quantity = q > 0 ? q : 1;\n  flow = 'await_address';\n  reply = 'Apnar full address ta diben please?';\n} else if (intent === 'order_address') {\n  if (text.length < 5) {\n    reply = 'Address ta detail kore likhben please.';\n  } else {\n    order.address = text;\n    flow = 'await_phone';\n    reply = 'Address peyechi. Phone number ta diben?';\n  }\n} else if (intent === 'order_phone') {\n  const digits = text.replace(/\\D/g, '');\n  if (digits.length < 10) {\n    reply = 'Phone number sothik moto diben (11 digit).';\n  } else {\n    order.phone = digits.slice(0, 15);\n    flow = 'await_confirm';\n    const total = (order.price || 0) * (order.quantity || 1);\n    reply = `Confirm? ${order.product} | ${order.size} | qty ${order.quantity}` +\n            ` | total ${total} BDT | ${order.phone}. (han / na)`;\n  }\n} else if (intent === 'order_confirm') {\n  if (isYes.test(lower)) {\n    order.status = 'pending';\n    saveOrder = true;\n    flow = null;\n    reply = 'Order confirm hoyeche. Shigree call korbo. Dhonnobad!';\n  } else if (isNo.test(lower)) {\n    flow = null; order = null;\n    reply = 'Theek ache, order baatil korlam.';\n  } else {\n    reply = 'Confirm korte han / na likhun.';\n  }\n}\nmemory.flow_state = flow;\nmemory.order = saveOrder ? null : order;\nmemory.last_mid = mid;\nmemory.turns.push({ role: 'user', content: text });\nmemory.turns.push({ role: 'assistant', content: reply });\nmemory.turns = memory.turns.slice(-10);\nreturn [{ json: {\n  psid, user_name: userName, text, mid, reply,\n  save_order: saveOrder,\n  order: order || {},\n  memory_json: JSON.stringify(memory)\n}}];\n"
      },
